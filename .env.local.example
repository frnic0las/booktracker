# ============================================================
# BookTracker — Environment Variables
# ============================================================
# Two env files are used:
#   .env.local       → local development (turso dev, localhost)
#   .env.local.prod  → production deploy (Turso cloud, Vercel)
#
# Copy this file to .env.local AND .env.local.prod, then fill
# in the appropriate values for each environment.
# ============================================================

# --- Turso Database ---
# Dev:  file:local.db  (no token needed)
# Prod: libsql://your-db-name-your-org.turso.io
#       → turso db show booktracker --url
TURSO_DATABASE_URL=
# Dev:  leave empty
# Prod: → turso db tokens create booktracker
TURSO_AUTH_TOKEN=

# --- Google Books API ---
# Same key for dev and prod
# → https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Dev:  http://localhost:3000
# Prod: https://your-domain.vercel.app
AUTH_URL=

# --- Production only (.env.local.prod) ---
# Vercel deploy token
# → https://vercel.com/account/settings/tokens
VERCEL_TOKEN=
# Vercel account email (must match git config user.email)
VERCEL_EMAIL=
